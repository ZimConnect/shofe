<script>
'use strict';
const PRICE_PER_KM=.38, HARARE=[-17.8252,31.0335];
let passengerBalance=150,driverBalance=0,isLive=false,maps={};
function money(n){return '$'+(Number(n)||0).toFixed(2)}
function get(id){return document.getElementById(id)}
function val(id){return (get(id)?.value||'').trim()}
function num(id){return Math.max(0,Number(val(id))||0)}
function setText(id,t){if(get(id))get(id).textContent=t}
function showPage(id){document.querySelectorAll('.page').forEach(p=>p.classList.toggle('active',p.id===id));window.scrollTo(0,0);setTimeout(()=>initMap(id),120);if(id==='p-admin')loadAdmin();if(id==='p-driver')renderDriverJobs()}
function getJobs(){try{return JSON.parse(localStorage.getItem('shofe_jobs')||'[]')}catch(e){return []}}
function saveJobs(jobs){localStorage.setItem('shofe_jobs',JSON.stringify(jobs));loadAdmin();renderDriverJobs()}
function newJob(type,pickup,dropoff,distance,fare,extra={}){const j={id:Date.now()+Math.floor(Math.random()*999),time:new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'}),type,pickup,dropoff,distance,fare,driverPay:fare*.85,platformFee:fare*.15,status:'open',...extra};const jobs=getJobs();jobs.push(j);saveJobs(jobs);return j}
function syncWallet(){setText('walletPassenger',money(passengerBalance));setText('walletCurrent',money(passengerBalance));setText('walletDriver',money(driverBalance));setText('driverTotalEarn',money(driverBalance))}
function debit(fare,payment){if(payment!=='Cash USD'&&passengerBalance<fare)return false;if(payment!=='Cash USD')passengerBalance-=fare;driverBalance+=fare*.85;syncWallet();return true}
function distanceHelp(id,statusId){const n=num(id);if(n<=0){setText(statusId,'Enter the trip distance in kilometres. Automatic Google routing is not configured yet.');return}setText(statusId,'Distance entered: '+n.toFixed(1)+' km. Fare updated.')}
function calcRideFare(){const base=Number(val('rideType'))||2,d=num('distance'),fare=base+d*PRICE_PER_KM;setText('rideBase',money(base));setText('rideDist',money(d*PRICE_PER_KM));setText('rideTotal',money(fare));setText('rideDriverPay',money(fare*.85));setText('ridePlatformFee',money(fare*.15));return fare}
function calcCourierPrice(){const s=get('cVehicle'),o=s.options[s.selectedIndex],base=Number(o.dataset.base)||0,rate=Number(o.dataset.km)||0,d=num('cDistance'),fare=base+d*rate;setText('calcBase',money(base));setText('calcDist',money(d*rate));setText('calcTotal',money(fare));setText('calcDriver',money(fare*.85));setText('calcPlatform',money(fare*.15));return fare}
function calcRoadside(){const d=num('rDistance'),fare=2+d*PRICE_PER_KM;setText('rDistFare',money(d*PRICE_PER_KM));setText('rTotal',money(fare));setText('rDriver',money(fare*.85));return fare}
function calcNight(){const d=num('nDistance'),fare=20+d;setText('nDistFare',money(d));setText('nTotal',money(fare));setText('nDriver',money(fare*.85));return fare}
function requestRide(){const pickup=val('from'),dropoff=val('to'),d=num('distance'),fare=calcRideFare();if(!pickup||!dropoff||d<=0){setText('rideStatus','Please enter pickup, destination and a distance greater than 0 km.');return}if(!debit(fare,val('pay'))){setText('rideStatus','Insufficient demo wallet balance. Add demo funds in Wallet or choose cash.');return}newJob('Ride',pickup,dropoff,d,fare,{payment:val('pay'),vehicle:val('rideType')});setText('rideStatus','Demo booking created. Fare '+money(fare)+'; driver share '+money(fare*.85)+'. No real payment was processed.')}
function requestCourier(){const pickup=val('cFrom'),dropoff=val('cTo'),d=num('cDistance'),fare=calcCourierPrice();if(!pickup||!dropoff||d<=0){setText('cStatus','Please enter pickup, destination and distance greater than 0 km.');return}if(!debit(fare,'Wallet')){setText('cStatus','Insufficient demo wallet balance. Top up in Wallet first.');return}newJob('Courier â€” '+val('cVehicle'),pickup,dropoff,d,fare,{weight:num('cWeight'),parcel:val('cParcel'),phone:val('cPhone')});setText('cStatus','Demo courier booking created: '+money(fare)+'. No real payment was processed.')}
function requestRoadside(){const pickup=val('rLocation'),problem=val('rProblem'),d=num('rDistance'),fare=calcRoadside();if(!pickup||d<=0){setText('rStatus','Please enter your location and provider distance greater than 0 km.');return}if(!debit(fare,'Wallet')){setText('rStatus','Insufficient demo wallet balance. Top up in Wallet first.');return}newJob('Roadside â€” '+problem,pickup,problem,d,fare,{car:val('rCar')});setText('rStatus','Demo roadside request created: '+money(fare)+'. No real payment was processed.')}
function requestNightOwl(){const pickup=val('nPickup'),dropoff=val('nDropoff'),d=num('nDistance'),fare=calcNight();if(!pickup||!dropoff||d<=0){setText('nStatus','Please enter pickup, destination and distance greater than 0 km.');return}if(!debit(fare,'Wallet')){setText('nStatus','Insufficient demo wallet balance. Top up in Wallet first.');return}newJob('Night Owl',pickup,dropoff,d,fare,{phone:val('nPhone'),car:val('nCar')});setText('nStatus','Demo Night Owl booking created: '+money(fare)+'. Please use a verified designated driver; no real payment was processed.')}
function topupWallet(){const a=Number(val('topupAmount'));if(!Number.isFinite(a)||a<=0){alert('Enter a valid amount greater than zero.');return}passengerBalance+=a;get('topupAmount').value='';syncWallet();alert('Demo balance updated by '+money(a)+'. This is not real money.')}
function cashoutDriver(){if(driverBalance<=0){alert('There are no demo earnings to cash out.');return}alert('Demo cashout recorded for '+money(driverBalance)+' to '+val('driverPayoutMethod')+'. No money was transferred.');driverBalance=0;syncWallet()}
function previewFile(input,imgId){const f=input.files&&input.files[0];if(!f)return;const img=get(imgId);img.src=URL.createObjectURL(f);img.style.display='block'}
function submitVerification(){if(!val('driverName')||!val('driverPhone')){setText('verifyStatus','Enter your name and phone number.');return}if(!get('licenceFile').files.length||!get('selfieFile').files.length){setText('verifyStatus','Please attach both licence and selfie photos.');return}setText('verifyStatus','Application preview saved in this browser only. Identity has NOT been verified or uploaded.')}
function toggleLive(){isLive=!isLive;get('liveBtn').className='live-btn '+(isLive?'live-on':'live-off');setText('liveBtn',isLive?'GO OFFLINE':'GO LIVE');setText('statusText',isLive?'ONLINE â€” DEMO MODE':'OFFLINE');setText('onlineBadge',isLive?'ONLINE':'OFFLINE');renderDriverJobs()}
function renderDriverJobs(){const list=get('jobsList');if(!list)return;const jobs=getJobs().filter(j=>j.status==='open');list.innerHTML='';if(!isLive){list.textContent='Tap GO LIVE to view available demo jobs.';return}if(!jobs.length){list.textContent='No open demo jobs yet.';return}jobs.forEach(j=>{const card=document.createElement('div');card.className='job';const title=document.createElement('b');title.textContent=j.type+' â€” '+money(j.fare);const desc=document.createElement('p');desc.textContent=j.pickup+' â†’ '+j.dropoff+' Â· '+j.distance+' km Â· driver share '+money(j.driverPay);const btn=document.createElement('button');btn.className='btn-main btn-green';btn.textContent='ACCEPT DEMO JOB';btn.onclick=()=>acceptLocal(j.id);card.append(title,desc,btn);list.append(card)})}
function acceptLocal(id){const jobs=getJobs(),j=jobs.find(x=>x.id===id);if(!j||j.status!=='open'){alert('This job is no longer open.');return}j.status='accepted';j.acceptedAt=new Date().toISOString();saveJobs(jobs);alert('Demo job accepted. This local prototype does not assign real rides or transfer earnings.')}
function loadAdmin(){const jobs=getJobs();let fare=0,fee=0,driver=0,open=0;const body=get('jobsTable');if(!body)return;body.innerHTML='';jobs.slice().reverse().forEach(j=>{fare+=j.fare;fee+=j.platformFee;driver+=j.driverPay;if(j.status==='open')open++;const tr=document.createElement('tr');[j.time,j.type,j.pickup+' â†’ '+j.dropoff,money(j.fare),money(j.platformFee),money(j.driverPay),j.status].forEach(v=>{const td=document.createElement('td');td.textContent=v;tr.append(td)});const td=document.createElement('td');if(j.status==='open'){const b=document.createElement('button');b.className='btn-cam';b.textContent='Close';b.onclick=()=>{const all=getJobs(),item=all.find(x=>x.id===j.id);if(item)item.status='closed';saveJobs(all)};td.append(b)}else td.textContent='â€”';tr.append(td);body.append(tr)});setText('totalRides',String(jobs.length));setText('totalComm',money(fee));setText('totalDriverPay',money(driver));setText('openJobs',String(open))}
function clearAll(){if(confirm('Delete all demo bookings stored in this browser?')){localStorage.removeItem('shofe_jobs');loadAdmin();renderDriverJobs()}}
function seedDemo(){const jobs=getJobs(),now=Date.now();jobs.push({id:now,time:'Demo',type:'Ride',pickup:'Joina City',dropoff:'Borrowdale',distance:8,fare:5.04,driverPay:4.284,platformFee:.756,status:'open'},{id:now+1,time:'Demo',type:'Courier â€” 3-Ton',pickup:'Copacabana',dropoff:'Chiredzi',distance:380,fare:990,driverPay:841.5,platformFee:148.5,status:'open'},{id:now+2,time:'Demo',type:'Roadside â€” Flat tyre',pickup:'Samora & 1st',dropoff:'Flat tyre',distance:5,fare:3.9,driverPay:3.315,platformFee:.585,status:'open'},{id:now+3,time:'Demo',type:'Night Owl',pickup:'Club 1Eighty',dropoff:'Borrowdale',distance:12,fare:32,driverPay:27.2,platformFee:4.8,status:'open'});saveJobs(jobs)}
function initMap(page){if(typeof L==='undefined')return;const ids={'p-passenger':'mapRide','p-courier':'mapCourier','p-driver':'mapDriver','p-roadside':'mapRoad','p-night':'mapNight'};const id=ids[page];if(!id||maps[id]){if(id&&maps[id])setTimeout(()=>maps[id].invalidateSize(),100);return}try{const m=L.map(id).setView(HARARE,12);L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{attribution:'Â© OpenStreetMap contributors',maxZoom:19}).addTo(m);L.marker(HARARE).addTo(m).bindPopup('Harare, Zimbabwe');maps[id]=m}catch(e){get(id).innerHTML='<div style="padding:20px">Map unavailable. Check your internet connection.</div>'}}
document.addEventListener('DOMContentLoaded',()=>{syncWallet();calcRideFare();calcCourierPrice();calcRoadside();calcNight();loadAdmin();setTimeout(()=>initMap('p-landing'),200)});
</script>
